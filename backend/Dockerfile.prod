FROM python:3.11-slim

WORKDIR /app

# Install system dependencies if needed (for Pillow, cryptography, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Create data directory for SQLite persistence
RUN mkdir -p /app/data

EXPOSE 8001

# Use uvicorn with workers (default 1, override with WORKERS env var)
# For 1 CPU → 1 worker, for 2 CPU → 2 workers
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers ${WORKERS:-1}"]
