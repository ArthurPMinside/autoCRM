# ============================================================
# autoCRM — Production Environment Example
# ============================================================
# 1. Copy this file to .env:  cp .env.example .env
# 2. Change SECRET_KEY to a long random string!
# 3. Update DATABASE_URL if you move the data folder
# ============================================================

# Database (SQLite — file stored in ./data/ on host)
DATABASE_URL=sqlite:////app/data/autocrm.db

# Security — generate strong key: openssl rand -hex 32
SECRET_KEY=change-me-to-64-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backend workers (1 for 1 CPU, 2 for 2 CPU)
WORKERS=1

# Redis (optional — uncomment if you add Redis later)
# REDIS_URL=redis://redis:6379/0

# Telegram bot (if used)
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# SMS provider (if used)
# SMS_API_KEY=your_sms_api_key
